<Window x:Class="CznTranslator.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CZN Translator — Настройки"
        Height="640" Width="920" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#0F1620" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- palette -->
        <SolidColorBrush x:Key="Bg"      Color="#0F1620"/>
        <SolidColorBrush x:Key="Panel"   Color="#18212E"/>
        <SolidColorBrush x:Key="Panel2"  Color="#1F2A39"/>
        <SolidColorBrush x:Key="Tile"    Color="#212D3D"/>
        <SolidColorBrush x:Key="Border1" Color="#2B3A4D"/>
        <SolidColorBrush x:Key="Border2" Color="#35485E"/>
        <SolidColorBrush x:Key="Accent"  Color="#F0A04B"/>
        <SolidColorBrush x:Key="AccentH" Color="#F6B268"/>
        <SolidColorBrush x:Key="Text1"   Color="#E7ECF3"/>
        <SolidColorBrush x:Key="Muted"   Color="#8B98AB"/>
        <SolidColorBrush x:Key="Good"    Color="#5CC98A"/>

        <!-- nav item -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text1}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26F0A04B"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- primary button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#20160A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentH}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ghost button -->
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Border2}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text input -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E151F"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="#131C27" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,16,16,14" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Accent}">
                            <TextBlock Text="CZ" Foreground="#1A1206" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CZN Translator" Foreground="{StaticResource Text1}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Настройки" Foreground="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                         Margin="0,8,0,0" SelectedIndex="0" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem>▤   Обзор</ListBoxItem>
                    <ListBoxItem>▧   Оверлей</ListBoxItem>
                    <ListBoxItem>🔑  Ключ API</ListBoxItem>
                    <ListBoxItem>⚙   Перевод</ListBoxItem>
                    <ListBoxItem>✓   Ревью</ListBoxItem>
                    <ListBoxItem>⟳   Обновление</ListBoxItem>
                </ListBox>

                <TextBlock DockPanel.Dock="Bottom" x:Name="Footer" Margin="16,10" Foreground="#637185" FontSize="11"
                           Text="—" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <Grid>
                <!-- OVERVIEW -->
                <StackPanel x:Name="PageDash">
                    <TextBlock Style="{StaticResource H1}" Text="Обзор базы"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Состояние czn.db и покрытие переводом."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <ItemsControl x:Name="Tiles">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="CovLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,10,0,6" Text="Покрытие переводом"/>
                            <Border Height="10" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CovFill" Width="0*"/>
                                        <ColumnDefinition x:Name="CovRest" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="6"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Ghost}" Content="Обновить" HorizontalAlignment="Left" Margin="0,14,0,0" Click="RefreshDash_Click"/>
                </StackPanel>

                <!-- OVERLAY -->
                <StackPanel x:Name="PageOverlay" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Оверлей"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Вид перевода поверх игры и какое окно отслеживать. Применяется на лету после сохранения."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Внешний вид" Foreground="{StaticResource Text1}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Шрифт"/>
                                    <TextBox x:Name="FontFamilyBox"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Размер шрифта"/>
                                    <TextBox x:Name="FontSizeBox"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Цвет текста (#RRGGBB)"/>
                                    <TextBox x:Name="TextColor"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Цвет фона (#RRGGBB)"/>
                                    <TextBox x:Name="BackdropColor"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Прозрачность фона (0–1)"/>
                                    <TextBox x:Name="BackdropOpacity"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,14,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Окно игры" Foreground="{StaticResource Text1}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Имя процесса"/>
                                    <TextBox x:Name="ProcessName"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Класс окна"/>
                                    <TextBox x:Name="WindowClass"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Btn}" Content="Сохранить" Click="SaveOverlay_Click"/>
                        <TextBlock x:Name="OverlayHint" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- PLACEHOLDER pages -->
                <StackPanel x:Name="PageKey" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Ключ API"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Скоро: ввод и хранение ключа (DPAPI) прямо здесь."/>
                </StackPanel>
                <StackPanel x:Name="PageTranslate" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Перевод"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Скоро: пакетный EN→RU прямо из приложения, с прогрессом."/>
                </StackPanel>
                <StackPanel x:Name="PageReview" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Ревью"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Скоро: очередь машинного перевода с приёмом/закреплением."/>
                </StackPanel>
                <StackPanel x:Name="PageUpdate" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Обновление после патча"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Скоро: пере-декод data.pack и обновление базы."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
