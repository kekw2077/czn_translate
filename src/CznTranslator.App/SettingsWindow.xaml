<Window x:Class="CznTranslator.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CZN Translator — Настройки"
        Height="640" Width="920" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#0F1620" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- palette -->
        <SolidColorBrush x:Key="Bg"      Color="#0F1620"/>
        <SolidColorBrush x:Key="Panel"   Color="#18212E"/>
        <SolidColorBrush x:Key="Panel2"  Color="#1F2A39"/>
        <SolidColorBrush x:Key="Tile"    Color="#212D3D"/>
        <SolidColorBrush x:Key="Border1" Color="#2B3A4D"/>
        <SolidColorBrush x:Key="Border2" Color="#35485E"/>
        <SolidColorBrush x:Key="Accent"  Color="#F0A04B"/>
        <SolidColorBrush x:Key="AccentH" Color="#F6B268"/>
        <SolidColorBrush x:Key="Text1"   Color="#E7ECF3"/>
        <SolidColorBrush x:Key="Muted"   Color="#8B98AB"/>
        <SolidColorBrush x:Key="Good"    Color="#5CC98A"/>

        <!-- nav item -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text1}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26F0A04B"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- primary button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#20160A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentH}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ghost button -->
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Border2}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text input -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E151F"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0E151F"/>
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="#131C27" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,16,16,14" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Accent}">
                            <TextBlock Text="CZ" Foreground="#1A1206" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CZN Translator" Foreground="{StaticResource Text1}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Настройки" Foreground="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                         Margin="0,8,0,0" SelectedIndex="0" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem>▤   Обзор</ListBoxItem>
                    <ListBoxItem>▧   Оверлей</ListBoxItem>
                    <ListBoxItem>🔑  Ключ API</ListBoxItem>
                    <ListBoxItem>⚙   Перевод</ListBoxItem>
                    <ListBoxItem>🖧  Станция</ListBoxItem>
                    <ListBoxItem>✓   Ревью</ListBoxItem>
                    <ListBoxItem>⟳   Обновление</ListBoxItem>
                </ListBox>

                <TextBlock DockPanel.Dock="Bottom" x:Name="Footer" Margin="16,10" Foreground="#637185" FontSize="11"
                           Text="—" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <Grid>
                <!-- OVERVIEW -->
                <StackPanel x:Name="PageDash">
                    <TextBlock Style="{StaticResource H1}" Text="Обзор базы"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Состояние czn.db и покрытие переводом."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <ItemsControl x:Name="Tiles">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="CovLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,10,0,6" Text="Покрытие переводом"/>
                            <Border Height="10" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CovFill" Width="0*"/>
                                        <ColumnDefinition x:Name="CovRest" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="6"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Ghost}" Content="Обновить" HorizontalAlignment="Left" Margin="0,14,0,0" Click="RefreshDash_Click"/>
                </StackPanel>

                <!-- OVERLAY -->
                <StackPanel x:Name="PageOverlay" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Оверлей"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Вид перевода поверх игры и какое окно отслеживать. Применяется на лету после сохранения."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Внешний вид" Foreground="{StaticResource Text1}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Шрифт"/>
                                    <TextBox x:Name="FontFamilyBox"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Размер шрифта"/>
                                    <TextBox x:Name="FontSizeBox"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Цвет текста (#RRGGBB)"/>
                                    <TextBox x:Name="TextColor"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,12">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Цвет фона (#RRGGBB)"/>
                                    <TextBox x:Name="BackdropColor"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Прозрачность фона (0–1)"/>
                                    <TextBox x:Name="BackdropOpacity"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,14,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Окно игры" Foreground="{StaticResource Text1}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Имя процесса"/>
                                    <TextBox x:Name="ProcessName"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Класс окна"/>
                                    <TextBox x:Name="WindowClass"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Btn}" Content="Сохранить" Click="SaveOverlay_Click"/>
                        <TextBlock x:Name="OverlayHint" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- PLACEHOLDER pages -->
                <StackPanel x:Name="PageKey" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Ключ API"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Ключ шифруется Windows DPAPI и хранится локально (%LocalAppData%). В открытом виде и в git не попадает."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Провайдер" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="ProvAnthropic" Style="{StaticResource Ghost}" Content="Anthropic (Claude)"
                                        Margin="0,0,8,0" Click="ProvAnthropic_Click"/>
                                <Button x:Name="ProvDeepseek" Style="{StaticResource Ghost}" Content="DeepSeek"
                                        Margin="0,0,8,0" Click="ProvDeepseek_Click"/>
                                <Button x:Name="ProvOpenai" Style="{StaticResource Ghost}" Content="OpenAI-совместимый"
                                        Click="ProvOpenai_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="KeyStatus" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,8,0,14" Text="—"/>
                            <TextBlock Text="API-ключ" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="KeyBox"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Btn}" Content="Сохранить ключ" Click="SaveKey_Click"/>
                                <TextBlock x:Name="KeyHint" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PageTranslate" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Перевод"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Пакетный EN→RU из приложения. Дубли схлопываются, память переводов переиспользуется. Результат — «mt», принимается во вкладке «Ревью»."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Провайдер" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="TransProvAnthropic" Style="{StaticResource Ghost}" Content="Anthropic (Claude)"
                                        Margin="0,0,8,0" Click="TransProvAnthropic_Click"/>
                                <Button x:Name="TransProvDeepseek" Style="{StaticResource Ghost}" Content="DeepSeek"
                                        Margin="0,0,8,0" Click="TransProvDeepseek_Click"/>
                                <Button x:Name="TransProvOpenai" Style="{StaticResource Ghost}" Content="OpenAI-совместимый"
                                        Click="TransProvOpenai_Click"/>
                            </StackPanel>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Модель (необязательно)"/>
                                    <TextBox x:Name="TransModel"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Объём (число строк, пусто = все)"/>
                                    <TextBox x:Name="TransLimit"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL (для OpenAI-совместимых хостов, необязательно)"/>
                                <TextBox x:Name="TransBaseUrl"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Btn}" Content="▶ Перевести" Click="Translate_Click"/>
                                <Button x:Name="TransStop" Style="{StaticResource Ghost}" Content="■ Стоп" IsEnabled="False"
                                        Margin="10,0,0,0" Click="TransStop_Click"/>
                                <TextBlock x:Name="TransHint" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                            <Border Margin="0,16,0,0" BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Или загрузите перевод, сделанный внешней нейросетью (файл {english: русский}):"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Ghost}" Content="Импорт перевода из файла (JSON)" Click="Import_Click"/>
                                        <TextBlock x:Name="ImportHint" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="TransProgress" Visibility="Collapsed" Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TransPct" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" Text="0%"/>
                                    <TextBlock x:Name="TransStat" Foreground="{StaticResource Muted}" FontSize="12" Text="—"/>
                                </DockPanel>
                                <Border Height="10" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="TransFill" Width="0*"/>
                                            <ColumnDefinition x:Name="TransRest" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="6"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Border x:Name="TransLogWrap" Visibility="Collapsed" Margin="0,14,0,0" Background="#0B1119"
                                    BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                                <ScrollViewer x:Name="TransLogScroll" MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TransLog" Foreground="#B7C4D4" FontSize="12"
                                               FontFamily="Cascadia Code, Consolas, monospace" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PageStation" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Станция перевода"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Перевод на своей машине (Ollama по Tailscale, модель qwen3:4b, CPU). На станцию уходит только текст с замаскированной разметкой ([0] [1]) — теги, плейсхолдеры и переносы не ломаются. Результат — «mt», проверяется во вкладке «Ревью»."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес станции (Tailscale), напр. http://100.x.y.z:11434"/>
                            <TextBox x:Name="StationEndpoint"/>
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Модель"/>
                                    <TextBox x:Name="StationModel"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Объём (число строк, пусто = все)"/>
                                    <TextBox x:Name="StationLimit"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="4" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Батч"/>
                                    <TextBox x:Name="StationBatch"/>
                                </StackPanel>
                                <StackPanel Margin="3,0,3,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Таймаут, сек"/>
                                    <TextBox x:Name="StationTimeout"/>
                                </StackPanel>
                                <StackPanel Margin="3,0,3,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Повторы"/>
                                    <TextBox x:Name="StationRetries"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Потоки CPU (0=авто)"/>
                                    <TextBox x:Name="StationThreads"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource Ghost}" Content="Сохранить" Click="StationSave_Click"/>
                                <Button x:Name="StationCheckBtn" Style="{StaticResource Ghost}" Content="Проверить соединение"
                                        Margin="10,0,0,0" Click="StationCheck_Click"/>
                                <Button x:Name="StationRunBtn" Style="{StaticResource Btn}" Content="▶ Перевести через станцию"
                                        Margin="10,0,0,0" Click="StationRun_Click"/>
                                <Button x:Name="StationStop" Style="{StaticResource Ghost}" Content="■ Стоп" IsEnabled="False"
                                        Margin="10,0,0,0" Click="StationStop_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="StationHint" Foreground="{StaticResource Muted}" Margin="2,12,0,0" TextWrapping="Wrap" Text="—"/>
                            <StackPanel x:Name="StationProgress" Visibility="Collapsed" Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="StationPct" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" Text="0%"/>
                                    <TextBlock x:Name="StationStat" Foreground="{StaticResource Muted}" FontSize="12" Text="—"/>
                                </DockPanel>
                                <Border Height="10" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="StationFill" Width="0*"/>
                                            <ColumnDefinition x:Name="StationRest" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource Accent}" CornerRadius="6"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Border x:Name="StationLogWrap" Visibility="Collapsed" Margin="0,14,0,0" Background="#0B1119"
                                    BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                                <ScrollViewer x:Name="StationLogScroll" MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="StationLog" Foreground="#B7C4D4" FontSize="12"
                                               FontFamily="Cascadia Code, Consolas, monospace" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PageReview" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Ревью"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Очередь машинного перевода. «Принять» делает строку памятью переводов — она переиспользуется на дублях."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button Style="{StaticResource Ghost}" Content="Обновить" DockPanel.Dock="Right" Click="ReviewReload_Click"/>
                                <Button x:Name="AcceptAllBtn" Style="{StaticResource Ghost}" Content="Принять все" DockPanel.Dock="Right"
                                        Margin="0,0,8,0" Click="AcceptAll_Click"/>
                                <TextBlock x:Name="ReviewTitle" Foreground="{StaticResource Text1}" FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center" Text="Очередь"/>
                            </DockPanel>
                            <StackPanel x:Name="ReviewList"/>
                            <StackPanel x:Name="ReviewPager" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PageUpdate" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Обновление после патча"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Пере-декодировать data.pack и обновить только изменения: новые → в очередь; изменённые → «stale» (старый перевод остаётся); удалённые сохраняются. Ручной перевод не теряется."/>
                    <Border Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Путь к data.pack"/>
                            <TextBox x:Name="UpdatePack"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="UpdateCheckBtn" Style="{StaticResource Ghost}" Content="Проверить обновление" Click="UpdateCheck_Click"/>
                                <Button x:Name="UpdateApplyBtn" Style="{StaticResource Btn}" Content="Применить изменения" Margin="10,0,0,0" Click="UpdateApply_Click"/>
                                <TextBlock x:Name="UpdateHint" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                            <ItemsControl x:Name="UpdateTiles" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Border x:Name="UpdateLogWrap" Visibility="Collapsed" Margin="0,14,0,0" Background="#0B1119"
                                    BorderBrush="{StaticResource Border1}" BorderThickness="1" CornerRadius="9" Padding="12,10">
                                <ScrollViewer x:Name="UpdateLogScroll" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="UpdateLog" Foreground="#B7C4D4" FontSize="12"
                                               FontFamily="Cascadia Code, Consolas, monospace" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
