# Copy this file to  tools/.env  (which is gitignored) and fill in ONE key.
# translate.py reads it automatically for --provider anthropic / openai.
# The key is never passed on the command line.

# Default provider: Anthropic (Claude). Best quality for game/narrative text, cheap with Haiku.
ANTHROPIC_API_KEY=

# Alternative: any OpenAI-compatible host. Use with:  --provider openai
# (add --base-url https://... for Together / Groq / OpenRouter / a local server)
# OPENAI_API_KEY=
